# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# VAT код для чека: 1=НДС 20%, 2=НДС 10%, 3=НДС 0%, 4=без НДС
YOOKASSA_VAT_CODE=4

# Bot username without @, e.g. my_cool_bot (needed for referral links)
BOT_USERNAME=
# Comma-separated Telegram IDs of admins who can use /refstats
ADMIN_IDS=

# ─── WebApp «Спросить ОКО» ────────────────────────────────────────────────
# Публичный HTTPS-адрес мини-аппа. Пусто = кнопка чата скрыта.
# Заполняется автоматически скриптом deploy/setup-web.sh
WEBAPP_URL=
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Лимит вопросов по максимальному купленному пакету
CHAT_LIMIT_DEMO=5
CHAT_LIMIT_BASE=30
CHAT_LIMIT_EXTENDED=60
CHAT_LIMIT_FULL=200

# Модель чата (по умолчанию берётся AI_MODEL)
# AI_CHAT_MODEL=
# AI_CHAT_MAX_TOKENS=1500

# ─── Отладка мини-аппа ────────────────────────────────────────────────────
# Отключает проверку подписи Telegram initData: мини-апп можно открыть
# в обычном браузере. ЛЮБОЙ запрос принимается без подписи — на сервере,
# доступном из интернета, включать нельзя.
# WEBAPP_AUTH_DISABLED=1
# Чей профиль показывать в этом режиме (переопределяется через ?tg_id=)
# WEBAPP_DEV_TELEGRAM_ID=